<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!--
        MANAGE_EXTERNAL_STORAGE は Explorer / Downloads / Documents で端末の共有ストレージを
        そのまま一覧するために必要。SAF と MediaStore だけでは設計書 6 章の
        「普通のファイルマネージャーとして成立する」要件を満たせない。

        本アプリは Google Play ではなく Dropbox 経由のサイドロードで配布しているため
        （scripts/release_build.ps1 を参照）、Play の制限付き権限の審査対象外。
        Play 配布に切り替える場合はこの権限を外し、SAF ベースへ設計変更すること。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="jp.viastrasse.home" />
        <package android:name="jp.viastrasse.mail" />
        <package android:name="jp.viastrasse.task" />
        <package android:name="jp.viastrasse.atelier" />
        <package android:name="jp.viastrasse.notify" />

        <!--
            資料詳細から Mail / Task / Atelier の参照を開くために、
            相手側のスキームを解決できる必要がある。
            自分自身のスキーム（viastrasse-cabinet）を宣言しても意味がない。
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="viastrasse-mail" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="viastrasse-task" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="viastrasse-atelier" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="viastrasse-home" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="viastrasse-notify" />
        </intent>

        <!-- 内蔵ビューアが非対応の形式を外部アプリへ渡すため。 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/CabinetTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="viastrasse-cabinet" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:theme="@style/CabinetTheme">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
            configChanges を指定しないと端末を回すたびに Activity が作り直され、
            動画は先頭から再生し直し、画像のズーム状態も失われる。
            回転はレイアウトの再測定だけで足りるため自前で受ける。
        -->
        <activity
            android:name=".ViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
            android:theme="@style/CabinetTheme" />

        <provider
            android:name=".integration.CabinetHomeSummaryProvider"
            android:authorities="jp.viastrasse.cabinet.provider.home"
            android:exported="true" />

        <provider
            android:name=".integration.CabinetSearchProvider"
            android:authorities="jp.viastrasse.cabinet.provider.search"
            android:exported="true" />

        <provider
            android:name=".integration.CabinetEventProvider"
            android:authorities="jp.viastrasse.cabinet.provider.events"
            android:exported="true" />

        <provider
            android:name=".integration.CabinetSaveProvider"
            android:authorities="jp.viastrasse.cabinet.provider.save"
            android:exported="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="jp.viastrasse.cabinet.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
